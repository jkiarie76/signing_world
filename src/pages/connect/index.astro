---
import { getEntry } from "astro:content";

import BaseLayout from "../../layouts/BaseLayout.astro";
import "../../styles/connect.css";

const globalSettings = await getEntry(
    "settings",
    "global-settings"
);

if (!globalSettings) {
    throw new Error("global-settings.md was not found.");
}

const connect = await getEntry(
    "connect",
    "connect-page"
);

if (!connect) {
    throw new Error("connect-page.md was not found.");
}

const hero = globalSettings.data.heroes.connect;
const data = connect.data;
---

<BaseLayout
    title="Connect | Signs Of Change KE"
    description="Connect with Signs Of Change KE, share your story, ask a question, or get involved."
    activePage="connect"
>

    <main class="connect-page">

        <!-- =========================================
             HERO VIDEO SECTION
        ========================================== -->

        <section class="connect-video-hero">

            <div class="connect-video-background">

                <img
                    src={hero.backgroundImage.src}
                    alt={hero.backgroundImage.alt}
                    class="connect-bg-image"
                />

                <div class="connect-video-overlay"></div>

            </div>


            <div class="container connect-video-content">

                <span class="eyebrow-light">

                    {hero.label}

                </span>

                <h1>

                    {hero.title}
                
                </h1>


                <p>

                   {hero.description}

                </p>

                <button
                    type="button"
                    class="welcome-video-button"
                    id="open-welcome-modal"
                >
                    <span class="welcome-play-icon">
                        <i class="fa-solid fa-play"></i>
                    </span>

                    <span>
                        Watch Welcome in Sign Language
                    </span>
                </button>

            </div>

        </section>


        <!-- =========================================
             WELCOME VIDEO MODAL
        ========================================== -->

        <div
            class="video-modal"
            id="welcome-video-modal"
            aria-hidden="true"
        >

            <div
                class="modal-backdrop"
                id="modal-backdrop"
            ></div>


            <div
                class="modal-content"
                role="dialog"
                aria-modal="true"
                aria-labelledby="welcome-video-title"
            >

                <button
                    type="button"
                    class="modal-close-button"
                    id="close-welcome-modal"
                    aria-label="Close welcome video"
                >
                    <i class="fa-solid fa-xmark"></i>
                </button>

                <h2 id="welcome-video-title" class="sr-only">
                    Welcome in Sign Language
                </h2>

                <div class="modal-video-wrapper">

                    <video
                        id="modal-player"
                        controls
                        preload="metadata"
                        poster= {hero.welcomeVideo.poster}
                    >

                        <source
                            src= {hero.welcomeVideo.video}
                            type="video/mp4"
                        />

                        <track
                            src= {hero.welcomeVideo.captions}
                            kind="captions"
                            srclang="en"
                            label="English"
                            default
                        />

                        Your browser does not support the video element.

                    </video>

                </div>

            </div>

        </div>


        <!-- =========================================
             ABOUT ME
        ========================================== -->

        <section class="connect-about-section">

            <div class="container connect-about-grid">

                <div class="connect-about-content">

                    <span class="section-eyebrow">
                        {data.about.eyebrow}
                    </span>

                    <h2>
                        {data.about.title}
                    </h2>

                    {
                        data.about.paragraphs.map((paragraph, index) => (
                            <p class={index > 0 ? "muted-text" : undefined}>
                                {paragraph}
                            </p>
                        ))
                    }

                </div>


                <div class="connect-about-image">

                    <img
                        src={data.about.image.src}
                        alt={data.about.image.alt}
                        loading="lazy"
                    />

                </div>

            </div>

        </section>


        <!-- =========================================
             MISSION
        ========================================== -->

        <section class="connect-mission-section">

            <div class="container">

                <span class="section-eyebrow">
                    {data.mission.eyebrow}
                </span>

                <h2 class="mission-heading">
                    {data.mission.heading}
                </h2>


                <div class="mission-grid">

                    {
                        data.values.map((value) => (

                            <article class="mission-card">

                                <h3>
                                    {value.title}
                                </h3>

                                <p>
                                    {value.description}
                                </p>

                            </article>

                        ))
                    }

                </div>

            </div>

        </section>


        <!-- =========================================
             CONTACT
        ========================================== -->

        <section class="connect-contact-section">

            <div class="container connect-contact-grid">


                <!-- Contact information -->

                <div class="contact-information">

                    <span class="section-eyebrow">
                        {data.contact.eyebrow}
                    </span>

                    <h2>
                        {data.contact.title}
                    </h2>

                    <p>
                        {data.contact.description}
                    </p>

                    <p>
                        <strong>Phone:</strong>

                        <a href={`tel:${data.contact.phone}`}>
                            {data.contact.phone}
                        </a>
                    </p>

                    <p>
                        <strong>Email:</strong>

                        <a href={`mailto:${data.contact.email}`}>
                            {data.contact.email}
                        </a>
                    </p>


                    <div class="contact-social-links">

                        {
                            data.contact.socialLinks.map((social) => (

                                <a
                                    href={social.url}
                                    aria-label={social.label}
                                    target="_blank"
                                    rel="noopener noreferrer"
                                >
                                    {
                                        social.platform === "Instagram" &&
                                        <i class="fa-brands fa-instagram"></i>
                                    }

                                    {
                                        social.platform === "Facebook" &&
                                        <i class="fa-brands fa-facebook-f"></i>
                                    }

                                    {
                                        social.platform === "X" &&
                                        <i class="fa-brands fa-x-twitter"></i>
                                    }

                                    {
                                        social.platform === "TikTok" &&
                                        <i class="fa-brands fa-tiktok"></i>
                                    }

                                    {
                                        social.platform === "Pinterest" &&
                                        <i class="fa-brands fa-pinterest-p"></i>
                                    }

                                    {
                                        social.platform === "WhatsApp" &&
                                        <i class="fa-brands fa-whatsapp"></i>
                                    }

                                    {
                                        social.platform === "YouTube" &&
                                        <i class="fa-brands fa-youtube"></i>
                                    }

                                </a>

                            ))
                        }

                    </div>

                </div>


                <!-- Contact form -->

                <div class="contact-form-wrapper">

                    <form
                        id="connect-contact-form"
                        class="connect-contact-form"
                        action="https://api.web3forms.com/submit"
                        method="POST"
                    >

                        <!-- Web3Forms access key -->
                        <input
                            type="hidden"
                            name="access_key"
                            value="55eef4d1-147e-44eb-88a8-d48190024fc9"
                        />

                        <input 
                            type="hidden" 
                            name="subject" 
                            value="New enquiry from Signing World website" 
                        />

                        <input
                            type="hidden"
                            name="from_name"
                            value="Signing World Website"
                        />


                        <label for="contact-name" class="sr-only">
                            Name
                        </label>

                        <input
                            id="contact-name"
                            type="text"
                            name="name"
                            placeholder="Name"
                            class="contact-input"
                            autocomplete="name"
                            required
                        />


                        <label for="contact-email" class="sr-only">
                            Email
                        </label>

                        <input
                            id="contact-email"
                            type="email"
                            name="email"
                            placeholder="Email"
                            class="contact-input"
                            autocomplete="email"
                            required
                        />


                        <label for="contact-subject" class="sr-only">
                            Subject
                        </label>

                        <input
                            id="contact-subject"
                            type="text"
                            name="subject"
                            placeholder="Subject"
                            class="contact-input"
                            required
                        />


                        <label for="contact-message" class="sr-only">
                            Message
                        </label>

                        <textarea
                            id="contact-message"
                            name="message"
                            placeholder="Message"
                            class="contact-textarea"
                            rows="6"
                            required
                        ></textarea>


                        <div class="form-submit-footer">

                            <span class="reply-guarantee">
                                We reply within 3 business days.
                            </span>

                            <button
                                type="submit"
                                class="form-submit-button"
                            >
                                Send Message
                            </button>

                        </div>


                        <p
                            id="form-result"
                            class="form-result-message"
                            aria-live="polite"
                        ></p>

                    </form>

                </div>

            </div>

        </section>


        <!-- =========================================
             FAQ
        ========================================== -->

        <section class="connect-faq-section">

            <div class="container faq-container">

                <span class="section-eyebrow">
                    {data.faq.eyebrow}
                </span>

                <h2>
                    {data.faq.title}
                </h2>


                <div class="faq-list">

                    {
                        data.faq.questions.map((item) => (

                            <article class="faq-item">

                                <button
                                    type="button"
                                    class="faq-trigger"
                                    aria-expanded="false"
                                >

                                    <span>
                                        {item.question}
                                    </span>

                                    <i class="fa-solid fa-chevron-down"></i>

                                </button>


                                <div class="faq-answer">

                                    <p>
                                        {item.answer}
                                    </p>

                                </div>

                            </article>

                        ))
                    }

                </div>

            </div>

        </section>



        <!-- =========================================
             BACK TO TOP
        ========================================== -->

        <button
            type="button"
            class="back-to-top"
            id="back-to-top"
            aria-label="Back to top"
        >
            <i class="fa-solid fa-arrow-up"></i>
        </button>

    </main>

</BaseLayout>


<script src="/assets/js/connect.js" defer></script>
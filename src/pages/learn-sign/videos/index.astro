---
import { getCollection } from "astro:content";

import BaseLayout from "../../../layouts/BaseLayout.astro";
import VideoCard from "../../../components/learn-sign/VideoCard.astro";

import "../../../styles/learn-sign-videos.css";

const videos = (
    await getCollection("videos")
)
    .sort(
        (a, b) =>
            b.data.publishedDate.valueOf() -
            a.data.publishedDate.valueOf()
    );
---

<BaseLayout
    title="Visual Sign Tutorials | Learn Sign | Signing World"
    description="Browse visual sign language tutorials covering alphabets, numbers, phrases and more."
    activePage="learn"
>

    <main class="learn-sign-videos-page">

        <div class="container">

            <!-- ==============================
                 BREADCRUMB
                 ============================== -->

            <nav class="breadcrumb-nav">

                <a href="/learn-sign/">
                    Learn Sign
                </a>

                <span aria-hidden="true">
                    &gt;
                </span>

                <span class="current-page">
                    Videos
                </span>

            </nav>


            <!-- ==============================
                 PAGE HEADER
                 ============================== -->

            <header class="video-page-header">

                <span class="eyebrow">
                    VIDEO LIBRARY
                </span>

                <h1>
                    Visual Sign Tutorials
                </h1>

                <p>
                    Browse our growing library of high-quality video
                    demonstrations to master sign language visually.
                </p>

            </header>


            <!-- ==============================
                 SEARCH + FILTER DOCK
                 ============================== -->

            <section
                class="control-dock"
                aria-label="Video library controls"
            >

                <div class="search-box-wrapper">

                    <i
                        class="fa-solid fa-magnifying-glass search-icon"
                        aria-hidden="true"
                    ></i>

                    <input
                        type="search"
                        id="video-search-input"
                        placeholder="Search by topic, keyword, or sign name..."
                        aria-label="Search video tutorials"
                    />

                </div>


                <div class="filters-wrapper">

                    <div class="select-custom">

                        <select id="filter-topic">

                            <option value="all">
                                All Topics
                            </option>

                            <option value="alphabet">
                                Alphabet & Letters
                            </option>

                            <option value="numbers">
                                Numbers & Counting
                            </option>

                            <option value="phrases">
                                Common Phrases
                            </option>

                        </select>

                    </div>


                    <div class="select-custom">

                        <select id="sort-order">

                            <option value="latest">
                                Sort: Latest Additions
                            </option>

                            <option value="oldest">
                                Sort: Oldest First
                            </option>

                        </select>

                    </div>

                </div>

            </section>


            <!-- ==============================
                 VIDEO GRID
                 ============================== -->

            <section
                class="video-grid-matrix"
                id="video-grid-matrix"
                aria-live="polite"
            >

                {
                    videos.map((video) => (
                        <VideoCard
                            image={video.data.thumbnail}
                            title={video.data.title}
                            sign={video.data.sign}
                            description={video.data.description}
                            topic={video.data.topic}
                            date={video.data.publishedDate.toLocaleDateString("en-GB", {
                                day: "numeric",
                                month: "short",
                                year: "numeric"
                            })}
                            duration={video.data.duration}
                            youtubeUrl={video.data.youtubeUrl}
                        />
                    ))
                }

            </section>


            <!-- ==============================
                 EMPTY STATE
                 ============================== -->

            <div
                class="empty-state-notice"
                id="empty-state-notice"
                hidden
            >

                <i
                    class="fa-regular fa-folder-open empty-icon"
                    aria-hidden="true"
                ></i>

                <h3>
                    No tutorial videos found
                </h3>

                <p>
                    Try another keyword or choose a different topic.
                </p>

                <button
                    type="button"
                    id="reset-video-filters"
                >
                    Reset Filters
                </button>

            </div>

        </div>

    </main>

</BaseLayout>

<script src="/assets/js/learn-sign-videos.js" is:inline></script>
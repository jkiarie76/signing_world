---
import { getCollection } from "astro:content";

import BaseLayout from "../../../layouts/BaseLayout.astro";

import AdvocacyFilters from "../../../components/deaf-world/AdvocacyFilters.astro";

import AdvocacyCard from "../../../components/shared/AdvocacyCard.astro";

import "../../../styles/deaf-world.css";


/* =========================================
   GET ADVOCACY CONTENT
========================================= */

const advocacyItems =
    await getCollection("advocacy");


/* =========================================
   ONLY SHOW PUBLISHED INITIATIVES
========================================= */

const publishedAdvocacy =
    advocacyItems
        .filter(
            (item) => item.data.published
        )
        .sort(
            (a, b) =>
                b.data.publishedDate.getTime() -
                a.data.publishedDate.getTime()
        );

---


<BaseLayout

    title="Advocacy | Deaf World | Signing World"

    description="Explore advocacy initiatives, legal resources and accessibility toolkits supporting Deaf communities."

    activePage="world"

>


<main class="deaf-world-advocacy-page">


    <!-- =====================================
         HEADER
    ====================================== -->

    <div class="container">


        <!-- BREADCRUMB -->

        <nav
            class="breadcrumb-nav"
            aria-label="Breadcrumb"
        >

            <a href="/deaf-world/">
                Deaf World
            </a>

            <span>›</span>

            <span class="current-page">
                Advocacy
            </span>

        </nav>


        <!-- PAGE HEADER -->

        <header class="advocacy-page-header">


            <span class="eyebrow">
                ADVOCACY
            </span>


            <h1>
                Advocacy & Policy Initiatives
            </h1>


            <p>
                Driving institutional change, breaking down systemic
                barriers, and securing baseline accessibility rights
                across public and digital spaces.
            </p>


        </header>


    </div>


    <!-- =====================================
         FILTERS
    ====================================== -->

    <AdvocacyFilters />


    <!-- =====================================
         ADVOCACY CONTENT
    ====================================== -->

    <section class="advocacy-content">


        <div class="container">


            <div
                class="advocacy-grid"
                data-advocacy-grid
            >


               
                {
                    publishedAdvocacy.map(
                        (item) => (

                            <AdvocacyCard
                                initiative={item}
                            />

                        )
                    )
                }


            </div>


            <!-- =================================
                 EMPTY STATE
            ================================== -->

            <div
                class="advocacy-empty-state hidden"
                data-empty-state
            >


                <div class="empty-state-icon">

                    <i class="fa-solid fa-bullhorn"></i>

                </div>


                <span class="eyebrow">
                    NO INITIATIVES YET
                </span>


                <h2>
                    Nothing to show here yet.
                </h2>


                <p>
                    There are currently no advocacy initiatives
                    in this category. Check back soon for new
                    campaigns, resources and accessibility work.
                </p>


                <button
                    type="button"
                    class="btn-explore-page"
                    data-reset-filters
                >

                    View All Initiatives →

                </button>


            </div>


        </div>


    </section>


</main>


</BaseLayout>
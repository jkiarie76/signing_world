---
import { getCollection } from "astro:content";
import BaseLayout from "../../../layouts/BaseLayout.astro";
import "../../../styles/deaf-world.css";

const articles = await getCollection("articles");

const stories = articles
    .filter(
        (article) =>
            article.data.category === "Stories"
    )
    .sort(
        (a, b) =>
            b.data.publishedDate.getTime() -
            a.data.publishedDate.getTime()
    );

const featuredStory = stories
    .filter((story) => story.data.featured)[0];

const regularStories = stories.filter(
    (story) => story.id !== featuredStory?.id
);
---

<BaseLayout
    title="Stories | Deaf World | Signing World"
    description="Stories, perspectives and reporting from Deaf communities across Kenya and around the world."
    activePage="world"
>

    <main class="deaf-world-stories-page">

        <!-- BREADCRUMB -->
        <section class="stories-header">

            <div class="container">

                <nav class="breadcrumb-nav">

                    <a href="/">
                        Home
                    </a>

                    <span>›</span>

                    <a href="/deaf-world">
                        Deaf World
                    </a>

                    <span>›</span>

                    <span class="current-page">
                        Stories
                    </span>

                </nav>

            </div>

        </section>


        <!-- FEATURED STORY -->
        <section class="stories-featured-section">

            <div class="container">

               {featuredStory && (

                    <article class="featured-story-hero">

                        <div class="hero-image-pane">

                            <img
                                src={featuredStory.data.featuredImage.src}
                                alt={featuredStory.data.featuredImage.alt}
                            />

                            <span class="story-badge hero-badge">

                                Featured

                            </span>

                        </div>


                        <div class="hero-content-pane">

                            <div class="story-meta-row">

                                <span class="story-author">

                                    <i class="fa-regular fa-user"></i>

                                    By {featuredStory.data.author}

                                </span>


                                <span class="story-read-time">

                                    <i class="fa-regular fa-clock"></i>

                                    {featuredStory.data.readTime} min read

                                </span>


                                <span class="story-date">

                                    {
                                        featuredStory.data.publishedDate.toLocaleDateString(
                                            "en-KE",
                                            {
                                                month: "short",
                                                day: "numeric",
                                                year: "numeric"
                                            }
                                        )
                                    }

                                </span>

                            </div>


                            <h1 class="hero-title">

                                {featuredStory.data.title}

                            </h1>


                            <p class="hero-excerpt">

                                {featuredStory.data.excerpt}

                            </p>


                            <a
                                href={`/deaf-world/stories/${featuredStory.id}`}
                                class="story-read-link"
                            >

                                Read Full Story

                                <i class="fa-solid fa-arrow-right"></i>

                            </a>

                        </div>

                    </article>

                )} 

            </div>

        </section>


        <!-- STORIES FEED -->
        <section class="stories-feed-section">

            <div class="container">

                <div class="stories-feed-grid">

                    {
                        regularStories.map((story) => (

                            <article class="story-editorial-card">

                                <div class="story-card-image">

                                    <img
                                        src={story.data.featuredImage.src}
                                        alt={story.data.featuredImage.alt}
                                    />

                                </div>


                                <div class="story-card-body">

                                    <div class="story-meta-row">

                                        <span class="story-badge">

                                            {story.data.topic}

                                        </span>


                                        <span class="story-author">

                                            <i class="fa-regular fa-user"></i>

                                            {story.data.author}

                                        </span>


                                        <span class="story-read-time">

                                            {story.data.readTime} min read

                                        </span>

                                    </div>


                                    <h2 class="story-card-title">

                                        {story.data.title}

                                    </h2>


                                    <p class="story-card-excerpt">

                                        {story.data.excerpt}

                                    </p>


                                    <a
                                        href={`/deaf-world/stories/${story.id}`}
                                        class="story-text-link"
                                    >

                                        Read Article

                                    </a>

                                </div>

                            </article>

                        ))
                    }

                </div>

            </div>

        </section>

    </main>

</BaseLayout>
---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import EventsFilters from "../../../components/deaf-world/EventsFilters.astro";
import EventCard from "../../../components/shared/EventCard.astro";

import "../../../styles/deaf-world.css";

import { getCollection } from "astro:content";

const allEvents = await getCollection("events");

const publishedEvents = allEvents
    .filter((event) => event.data.published);

const today = new Date();

today.setHours(0, 0, 0, 0);

const events = publishedEvents
    .map((event) => {

        const eventDate = new Date(event.data.eventDate);

        eventDate.setHours(0, 0, 0, 0);

        return {
            ...event,
            status:(
                eventDate >= today
                    ? "upcoming"
                    : "past"
            ) as "upcoming" | "past"
        };

    })
    .sort((a, b) =>
        a.data.eventDate.getTime() -
        b.data.eventDate.getTime()
    );
---

<BaseLayout
    title="Events | Deaf World | Signing World"
    description="Discover workshops, meetups, webinars and community events across the Deaf world."
    activePage="world"
>

    <main class="deaf-world-events-page">

        <div class="container">

            <!-- Breadcrumb -->

            <nav class="breadcrumb-nav">

                <a href="/deaf-world/">
                    Deaf World
                </a>

                <span> &gt; </span>

                <span class="current-page">
                    Events
                </span>

            </nav>


            <!-- Page Header -->

            <header class="events-page-header">

                <span class="eyebrow">
                    EVENTS
                </span>

                <h1>
                    Community Events & Workshops
                </h1>

                <p>
                    Join interactive workshops, cultural sign language
                    meetups, conferences and inclusive community webinars.
                </p>

            </header>

        </div>


        <!-- Filters -->

        <EventsFilters />


        <!-- Events will go here -->

        <section class="events-content">

            <div class="container">

                <div
                class="events-grid"
                data-events-grid
                >

                   {
                        events.map((event) => {

                            const eventDate = event.data.eventDate;

                            const displayDate = eventDate
                                .toLocaleDateString("en-KE", {
                                    month: "short"
                                })
                                .toUpperCase();

                            const day = eventDate.toLocaleDateString("en-KE", {
                                day: "2-digit"
                            });

                            return (
                                <EventCard
                                    image={event.data.featuredImage.src}
                                    imageAlt={event.data.featuredImage.alt}

                                    title={event.data.title}
                                    description={event.data.excerpt}

                                    displayDate={displayDate}
                                    day={day}

                                    startTime={event.data.startTime}
                                    endTime={event.data.endTime}

                                    eventType={event.data.eventType}

                                    location={event.data.location}
                                    organizer={event.data.organizer}

                                    status={event.status}
                                    slug={event.id}

                                    registrationUrl={event.data.registrationUrl}

                                    registrationLabel={event.data.registrationLabel}
                                />
                            );

                        })
                    }

                </div>

                <div
                    class="events-empty-state hidden"
                    data-empty-state
                >
                    <div class="empty-state-icon">
                        <i class="fa-regular fa-calendar"></i>
                    </div>

                    <span class="eyebrow">
                        NO EVENTS YET
                    </span>

                    <h2>
                        Nothing to show here yet.
                    </h2>

                    <p>
                        There are currently no events in this category.
                        Check back soon for new workshops, meetups,
                        conferences and community gatherings.
                    </p>

                    <button
                        type="button"
                        class="btn-explore-page"
                        data-reset-filters
                    >
                        View Upcoming Events →
                    </button>
                </div>

            </div>

        </section>

    </main>

</BaseLayout>
---
import "../styles/global.css";
import "../styles/components.css";
import "../styles/deaf-culture.css";
import "../styles/newsletter.css"
import FloatingSocials from "../components/shared/FloatingSocials.astro";

import Footer from "../components/layout/Footer.astro";
import BackToTop from "../components/shared/BackToTop.astro";
import Header from "../components/layout/Header.astro";

export interface Props {
  title?: string;
  description?: string;
  activePage?: string;
}

const {
  title = "Signing World",
  description = "Bridging the Deaf and Hearing communities through education, stories and sign language.",
  activePage = "home"
} = Astro.props;
---

<!DOCTYPE html>
<html lang="en">
<head>

    <meta charset="UTF-8" />

    <meta
        name="viewport"
        content="width=device-width, initial-scale=1.0"
    />

    <title>{title}</title>

    <meta
        name="description"
        content={description}
    />

    <link
        rel="icon"
        type="image/svg+xml"
        href="/uploads/favicon.svg"
    />

    <!-- Font Awesome -->
    <link
        rel="stylesheet"
        href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.7.2/css/all.min.css"
    />

</head>

<body>

    <Header activePage={activePage} />

    <slot />

    <FloatingSocials />

    <BackToTop />

    <Footer />


    <script is:inline src="/assets/js/header.js"></script>
    <script is:inline src="/assets/js/main.js"></script>
    <script is:inline src="/assets/js/flipcard.js"></script>
    <script is:inline src="/assets/js/collection-filter.js"></script>
    <script is:inline src="/assets/js/progress-bar.js"></script>

</body>

</html>
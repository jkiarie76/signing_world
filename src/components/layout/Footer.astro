---
import { getCollection } from "astro:content";

import {
    Facebook,
    Instagram,
    Youtube,
    Mail,
    Phone,
    MapPin
} from "lucide-astro";

const settings = await getCollection("settings");
const globalSettings = settings[0];
---

<footer class="site-footer">

    <div class="container">

        <div class="footer-grid">

            <!-- Brand -->

            <div class="footer-brand">

                <h2>Signing World</h2>

                <p>

                   {globalSettings.data.footer.description} 

                </p>

                <div class="footer-socials">

                    {globalSettings.data.social.facebook && (
                        <a
                            href={globalSettings.data.social.facebook}
                            aria-label="Facebook"
                            target="_blank"
                            rel="noopener noreferrer"
                        >
                            <Facebook size={20}/>
                        </a>
                    )}

                    {globalSettings.data.social.instagram && (
                        <a
                            href={globalSettings.data.social.instagram}
                            aria-label="Instagram"
                            target="_blank"
                            rel="noopener noreferrer"
                        >
                            <Instagram size={20}/>
                        </a>
                    )}

                    {globalSettings.data.social.youtube && (
                        <a
                            href={globalSettings.data.social.youtube}
                            aria-label="YouTube"
                            target="_blank"
                            rel="noopener noreferrer"
                        >
                            <Youtube size={20}/>
                        </a>
                    )}

                </div>

            </div>

            <!-- Explore -->

            <div>

                <h4>Explore</h4>

                <ul>

                    <li><a href="/">Home</a></li>

                    <li><a href="/learn-sign">Learn Sign</a></li>

                    <li><a href="/deaf-culture">Deaf Culture</a></li>

                    <li><a href="/deaf-world">Deaf World</a></li>

                    <li><a href="/connect">Connect</a></li>

                </ul>

            </div>

            <!-- Resources -->

            <div>

                <h4>Resources</h4>

                <ul>

                    <li><a href="/connect">About</a></li>

                    <li><a href="/privacy">Privacy Policy</a></li>

                    <li><a href="/terms">Terms & Conditions</a></li>

                    <li><a href="/connect">FAQs</a></li>

                </ul>

            </div>

            <!-- Contact -->

            <div>

                <h4>Contact</h4>

                <ul class="footer-contact">

                    <li>
                        <Mail size={16}/>
                        {globalSettings.data.contact.email}
                    </li>

                    <li>
                        <Phone size={16}/>
                        {globalSettings.data.contact.phone}
                    </li>

                    <li>
                        <MapPin size={16}/>
                        {globalSettings.data.contact.location}
                    </li>

                </ul>

            </div>

        </div>

        <div class="footer-bottom">

            <p>

                {globalSettings.data.footer.copyright}
                <span class="footer-tagline">
                    "{globalSettings.data.footer.tagline}"
                </span>

            </p>

        </div>

    </div>

</footer>